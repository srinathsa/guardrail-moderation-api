# --- Auth: x-api-key for /moderate/* (service-to-service) ---
API_KEY=changeme-please-set-a-strong-key
AUTH_MODE=api_key

# --- Guardrail thresholds (0.0 - 1.0) ---
THRESHOLD_FLAG=0.5
THRESHOLD_BLOCK=0.85

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./guardrail.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://guardrail:guardrail@postgres:5432/guardrail

# --- CORS ---
CORS_ORIGINS=*

# --- Model modes: auto (try ML, fall back to stub) | ml (force ML) | stub (force heuristic) ---
TEXT_MODEL_MODE=auto
IMAGE_MODEL_MODE=auto
HF_IMAGE_MODEL=Falconsai/nsfw_image_detection

INPUT_PREVIEW_CHARS=200
APP_NAME=Guardrail Moderation API

# --- JWT auth: dashboard logins (review.html, analytics.html, admin.html) ---
SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Bootstrap admin account, auto-created on first startup if no users exist yet.
# Change these before first startup in any real deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Public social feed demo (frontend/feed.html) ---
# Directory where uploaded post images are stored, served at /media/<file>.
MEDIA_DIR=media

# --- Optional: Reddit integration (integrations/reddit_moderator.py) ---
# Pulls real posts/comments from any public subreddit and runs them through
# this API's own /moderate/text endpoint. Free credentials, ~2 minutes:
# https://www.reddit.com/prefs/apps ("script" app type).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=guardrail-bridge by u/your_reddit_username

# --- Optional: Instagram integration (integrations/instagram_moderator.py) ---
# Moderates comments on YOUR OWN Instagram Professional (Business/Creator)
# account via Meta's official Graph API. Meta does not allow free access to
# arbitrary public Instagram content — only your own connected account.
# Full setup steps are in the script's docstring.
META_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
